# ============================================================
# 临床 AI 工作台 (Clinical AI Workbench) 环境变量示例
# 复制为 .env 后按需填写
# ============================================================

# ---------- MySQL 关系数据库 ----------
# 注意：Docker Toolbox 环境外部服务地址要用虚拟机 IP（docker-machine ip，如 192.168.99.100），不能用 localhost
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=clinical_workbench

# ---------- Milvus 向量数据库 ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
EMBEDDING_DIM=1024

# ---------- MinIO 对象存储 ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---------- Redis / Celery 异步队列 ----------
REDIS_URL=redis://localhost:6379

# ---------- 国产 LLM API ----------
# qwen | deepseek | sensenova
LLM_PROVIDER=sensenova
# SenseNova 商汤日日新（OpenAI 兼容），模型/端点可全局覆盖
SENSENOVA_API_KEY=your_sensenova_api_key
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=glm-5.2
QWEN_API_KEY=your_qwen_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
# 全局覆盖（可选）：设置后优先于上方各 provider 配置
# LLM_API_KEY=your_llm_api_key
# LLM_BASE_URL=https://token.sensenova.cn/v1
# LLM_MODEL=glm-5.2
# 通义千问 text-embedding-v2
EMBEDDING_API_KEY=your_embedding_api_key

# ---------- SenseCore 知识库 RAG（发布后会话接口 chat-release） ----------
# 文档：https://www.sensecore.cn/help/docs/model-as-a-service/AI_Studio/API/RAG_openapi/conversation/chat-release
SENSECORE_RAG_URL=https://rag.cn-sh-01.sensecoreapi.cn/studio/rag/chat/v1/release:chat
# 已发布应用的 release_key（仅作请求体标识，不能用于鉴权）
SENSECORE_RELEASE_KEY=your_release_key
# 鉴权（二选一）：A) 控制台 AccessKey/SecretKey（推荐，HMAC 动态签名）
SENSECORE_ACCESS_KEY=your_access_key
SENSECORE_SECRET_KEY=your_secret_key
# B) 或浏览器 DevTools 复制的完整 Authorization 头值（如 Bearer eyJ... / hmac accesskey="...")
SENSECORE_BEARER_TOKEN=

# ---------- NestJS BFF ----------
# FastAPI 推理服务地址（BFF 转发目标；使用 127.0.0.1 避免 Node18 fetch 解析 localhost 到 IPv6 ::1 失败）
INFERENCE_URL=http://127.0.0.1:8000
# JWT 密钥（生产环境务必改为强随机值）
JWT_SECRET=change_me_to_a_long_random_secret
# BFF 允许跨域的前端来源，逗号分隔（线上部署必填，如 https://workbench.example.com）
CORS_ORIGIN=http://localhost:3000

# ---------- Next.js 认证 ----------
NEXTAUTH_SECRET=change_me_to_a_long_random_secret
NEXTAUTH_URL=http://localhost:3000

# ---------- 前端 API 地址（线上部署必填，Docker 构建期注入） ----------
NEXT_PUBLIC_API_BASE=http://localhost:3001/api

# ---------- 字段级加密 (AES-256-GCM) ----------
FIELD_ENCRYPTION_KEY=change_me_to_a_32_byte_secret_key

# ---------- 审计日志 ----------
# 审计日志保留年数（spec 要求 6 年）
AUDIT_RETENTION_YEARS=6
