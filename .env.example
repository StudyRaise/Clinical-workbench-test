# ============================================================
# 临床 AI 工作台 (Clinical AI Workbench) 环境变量示例
# 复制为 .env 后按需填写
# ============================================================

# ---------- MySQL 关系数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=clinical_workbench

# ---------- Milvus 向量数据库 ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
EMBEDDING_DIM=1024

# ---------- MinIO 对象存储 ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---------- Redis / Celery 异步队列 ----------
REDIS_URL=redis://localhost:6379

# ---------- 国产 LLM API ----------
# qwen | deepseek
LLM_PROVIDER=qwen
QWEN_API_KEY=your_qwen_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
# 通义千问 text-embedding-v2
EMBEDDING_API_KEY=your_embedding_api_key

# ---------- NestJS BFF ----------
# FastAPI 推理服务地址（BFF 转发目标）
INFERENCE_URL=http://localhost:8000
# JWT 密钥（生产环境务必改为强随机值）
JWT_SECRET=change_me_to_a_long_random_secret

# ---------- Next.js 认证 ----------
NEXTAUTH_SECRET=change_me_to_a_long_random_secret
NEXTAUTH_URL=http://localhost:3000

# ---------- 字段级加密 (AES-256-GCM) ----------
FIELD_ENCRYPTION_KEY=change_me_to_a_32_byte_secret_key

# ---------- 审计日志 ----------
# 审计日志保留年数（spec 要求 6 年）
AUDIT_RETENTION_YEARS=6
