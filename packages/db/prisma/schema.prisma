datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  plan        String
  monthlyCap  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  apiKeys     ApiKey[]
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  createdAt DateTime @default(now())
  revokedAt DateTime?
}

model PromptTrace {
  id          String   @id @default(cuid())
  tenantId    String
  promptHash  String
  template    String
  model       String
  inputTokens Int
  outputTokens Int
  latencyMs   Int
  createdAt   DateTime @default(now())
}
